# Local Moodle configuration for Feature 004 Non-Functional Testing (NFR-07 & NFR-08)
# Copy to .env and fill local test credentials. Never commit .env or real passwords.
MOODLE_BASE_URL=http://127.0.0.1:9502
MOODLE_ADMIN_USERNAME=admin
MOODLE_ADMIN_PASSWORD=REPLACE_WITH_TEST_ADMIN_PASSWORD
MOODLE_COURSE_ID=2
MOODLE_SECTION_ID=2
MOODLE_WEB_CONTAINER=moodle-demo-webserver-1
MOODLE_CONFIG_PATH=/var/www/site/moodle/config.php
