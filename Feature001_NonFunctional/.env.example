MOODLE_BASE_URL=http://127.0.0.1:9502
MOODLE_ADMIN_USERNAME=admin
MOODLE_ADMIN_PASSWORD=REPLACE_ME
# Name/ID of the Moodle PHP webserver container (docker ps --format '{{.Names}}')
MOODLE_WEB_CONTAINER=
# Optional absolute path to Moodle config.php inside webserver; autodetect common paths.
MOODLE_CONFIG_PATH=
# Dedicated existing non-admin accounts; student/teacher role assigned in a test course.
MOODLE_STUDENT_USERNAME=
MOODLE_STUDENT_PASSWORD=
MOODLE_TEACHER_USERNAME=
MOODLE_TEACHER_PASSWORD=
