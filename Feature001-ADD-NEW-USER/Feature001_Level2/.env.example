# Copy to .env and replace the password with the credentials for your local test site.
# The script loads this file automatically at startup (do not commit it).
MOODLE_BASE_URL=http://127.0.0.1:9502
MOODLE_ADMIN_USERNAME=admin
MOODLE_ADMIN_PASSWORD=REPLACE_WITH_TEST_ADMIN_PASSWORD

# Optional F04 finite-size boundary: actual configured limit in bytes.
# MOODLE_IMAGE_MAX_BYTES=1048576
# F11 access control: dedicated authenticated user without moodle/user:create.
# MOODLE_RESTRICTED_USERNAME=restricted_test_user
# MOODLE_RESTRICTED_PASSWORD=REPLACE_WITH_RESTRICTED_TEST_PASSWORD
