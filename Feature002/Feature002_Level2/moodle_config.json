{
  "base_url": "http://127.0.0.1:9501",
  "paths": {
    "login": "/login/index.php",
    "login_area": "/login/",
    "create_course": "/course/edit.php?category=0",
    "edit_course": "/course/edit.php?id={course_id}",
    "view_course": "/course/view.php",
    "activity_setup": ["/course/mod.php", "/course/modedit.php"],
    "course_search": "/course/management.php?search={term}&perpage=100&page={page}",
    "directory_index": "index.php"
  },
  "query_parameters": {
    "course_id": "id",
    "activity_course_id": "course"
  },
  "locators": {
    "username": {"by": "id", "value": "username"},
    "password": {"by": "id", "value": "password"},
    "login_button": {"by": "id", "value": "loginbtn"},
    "fullname": {"by": "id", "value": "id_fullname"},
    "shortname": {"by": "id", "value": "id_shortname"},
    "idnumber": {"by": "id", "value": "id_idnumber"},
    "category": {"by": "id", "value": "id_category"},
    "category_selection": {"by": "css selector", "value": "#fitem_id_category .form-autocomplete-selection [role=\"option\"]"},
    "visible": {"by": "id", "value": "id_visible"},
    "startdate_year": {"by": "id", "value": "id_startdate_year"},
    "startdate_month": {"by": "id", "value": "id_startdate_month"},
    "startdate_day": {"by": "id", "value": "id_startdate_day"},
    "startdate_hour": {"by": "id", "value": "id_startdate_hour"},
    "startdate_minute": {"by": "id", "value": "id_startdate_minute"},
    "enddate_year": {"by": "id", "value": "id_enddate_year"},
    "enddate_month": {"by": "id", "value": "id_enddate_month"},
    "enddate_day": {"by": "id", "value": "id_enddate_day"},
    "enddate_hour": {"by": "id", "value": "id_enddate_hour"},
    "enddate_minute": {"by": "id", "value": "id_enddate_minute"},
    "enddate_enabled": {"by": "id", "value": "id_enddate_enabled"},
    "newsitems": {"by": "id", "value": "id_newsitems"},
    "format": {"by": "id", "value": "id_format"},
    "hiddensections": {"by": "id", "value": "id_hiddensections"},
    "coursedisplay": {"by": "id", "value": "id_coursedisplay"},
    "lang": {"by": "id", "value": "id_lang"},
    "showgrades": {"by": "id", "value": "id_showgrades"},
    "showreports": {"by": "id", "value": "id_showreports"},
    "showactivitydates": {"by": "id", "value": "id_showactivitydates"},
    "maxbytes": {"by": "id", "value": "id_maxbytes"},
    "enablecompletion": {"by": "id", "value": "id_enablecompletion"},
    "showcompletionconditions": {"by": "id", "value": "id_showcompletionconditions"},
    "groupmode": {"by": "id", "value": "id_groupmode"},
    "groupmodeforce": {"by": "id", "value": "id_groupmodeforce"},
    "section_ancestor": {"by": "xpath", "value": "./ancestor::fieldset[starts-with(@id, 'id_')][1]"},
    "section_toggle": {"by": "css selector", "value": "[aria-controls=\"{section_id}container\"][aria-expanded=\"false\"]"},
    "choice_trigger": {"by": "css selector", "value": "#fitem_{control_id} [data-for=\"dropdowndialog_button\"]"},
    "choice_option": {"by": "css selector", "value": "#fitem_{control_id} [role=\"option\"][data-value=\"{option_value}\"]"},
    "summary_textarea": {"by": "name", "value": "summary_editor[text]"},
    "summary_frame": {"by": "id", "value": "{editor_id}_ifr"},
    "summary_body": {"by": "css selector", "value": "body[contenteditable=\"true\"]"},
    "save_and_display": {"by": "id", "value": "id_saveanddisplay"},
    "cancel": {"by": "id", "value": "id_cancel"},
    "course_heading": {"by": "css selector", "value": "#page-header h1"},
    "all_validation_errors": {"by": "css selector", "value": "[id^=id_error_]"},
    "search_listing": {"by": "css selector", "value": "[data-category=\"search\"]"},
    "search_item": {"by": "css selector", "value": "li.listitem-course[data-id]"}
  },
  "error_locators": {
    "id_error_fullname": {"by": "id", "value": "id_error_fullname"},
    "id_error_shortname": {"by": "id", "value": "id_error_shortname"},
    "id_error_category": {"by": "id", "value": "id_error_category"},
    "id_error_enddate": {"by": "id", "value": "id_error_enddate"},
    "id_error_idnumber": {"by": "id", "value": "id_error_idnumber"}
  }
}
